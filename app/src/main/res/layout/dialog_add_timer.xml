<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <!-- Top Drag Handle (Zero Radius Sharp Bar) -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/surface_card_stroke_bright" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CREATE TIMER"
        android:textColor="@color/primary"
        android:textSize="10.5sp"
        android:letterSpacing="0.14"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="New Countdown"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Timer Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:hint="Timer Name (e.g. Focus Sprint)"
        app:boxCornerRadiusBottomEnd="0dp"
        app:boxCornerRadiusBottomStart="0dp"
        app:boxCornerRadiusTopEnd="0dp"
        app:boxCornerRadiusTopStart="0dp"
        app:boxStrokeColor="@color/surface_card_stroke_bright"
        app:hintTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_timer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Preset Chips Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Quick Presets"
        android:textColor="@color/text_sub"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Quick Presets -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_presets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_1m"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 min"
                android:textColor="@color/text_main"
                app:cornerRadius="0dp"
                app:chipBackgroundColor="@color/surface_card_inner"
                app:chipStrokeColor="@color/surface_card_stroke_bright" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_5m"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 min"
                android:textColor="@color/text_main"
                app:cornerRadius="0dp"
                app:chipBackgroundColor="@color/surface_card_inner"
                app:chipStrokeColor="@color/surface_card_stroke_bright" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_15m"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 min"
                android:textColor="@color/text_main"
                app:cornerRadius="0dp"
                app:chipBackgroundColor="@color/surface_card_inner"
                app:chipStrokeColor="@color/surface_card_stroke_bright" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_25m"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 min"
                android:textColor="@color/text_main"
                app:cornerRadius="0dp"
                app:chipBackgroundColor="@color/surface_card_inner"
                app:chipStrokeColor="@color/primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_45m"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 min"
                android:textColor="@color/text_main"
                app:cornerRadius="0dp"
                app:chipBackgroundColor="@color/surface_card_inner"
                app:chipStrokeColor="@color/surface_card_stroke_bright" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_60m"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 min"
                android:textColor="@color/text_main"
                app:cornerRadius="0dp"
                app:chipBackgroundColor="@color/surface_card_inner"
                app:chipStrokeColor="@color/surface_card_stroke_bright" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Custom Duration Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:hint="Hours"
            app:boxCornerRadiusBottomEnd="0dp"
            app:boxCornerRadiusBottomStart="0dp"
            app:boxCornerRadiusTopEnd="0dp"
            app:boxCornerRadiusTopStart="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:hint="Minutes"
            app:boxCornerRadiusBottomEnd="0dp"
            app:boxCornerRadiusBottomStart="0dp"
            app:boxCornerRadiusTopEnd="0dp"
            app:boxCornerRadiusTopStart="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:text="25"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="Seconds"
            app:boxCornerRadiusBottomEnd="0dp"
            app:boxCornerRadiusBottomStart="0dp"
            app:boxCornerRadiusTopEnd="0dp"
            app:boxCornerRadiusTopStart="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_seconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Music / Sound Selection Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Alarm Sound &amp; Music"
        android:textColor="@color/text_sub"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Audio Type Selector: System vs YouTube Music -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_audio_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_type_system"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="🔔 System / File"
            android:textColor="@color/text_main"
            app:cornerRadius="0dp"
            app:chipBackgroundColor="@color/surface_card_inner"
            app:chipStrokeColor="@color/surface_card_stroke_bright" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_type_youtube"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="▶️ YouTube Music"
            android:textColor="@color/text_main"
            app:cornerRadius="0dp"
            app:chipBackgroundColor="@color/surface_card_inner"
            app:chipStrokeColor="@color/surface_card_stroke_bright" />
    </com.google.android.material.chip.ChipGroup>

    <!-- System Sound Selection Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_select_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card_inner"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/surface_card_stroke_bright"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="20sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_selected_sound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Default Alarm"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to choose music or ringtone"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_sound"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Choose"
                android:textColor="@color/text_sub"
                android:textSize="11sp"
                app:cornerRadius="0dp"
                app:strokeColor="@color/surface_card_stroke_bright" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- YouTube Music Container -->
    <LinearLayout
        android:id="@+id/layout_youtube_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Song Name, Artist or music.youtube.com URL"
            app:boxCornerRadiusBottomEnd="0dp"
            app:boxCornerRadiusBottomStart="0dp"
            app:boxCornerRadiusTopEnd="0dp"
            app:boxCornerRadiusTopStart="0dp"
            app:boxStrokeColor="@color/surface_card_stroke_bright"
            app:hintTextColor="@color/text_sub">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_youtube_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri|text"
                android:text="Lo-Fi Beats to Relax/Study to"
                android:textColor="@color/text_main"
                android:textSize="13.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- YouTube Music Quick Preset Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_yt_presets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_yt_lofi"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎧 Lo-Fi Chill"
                    android:textColor="@color/text_main"
                    app:cornerRadius="0dp"
                    app:chipBackgroundColor="@color/surface_card_inner"
                    app:chipStrokeColor="@color/surface_card_stroke_bright" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_yt_hype"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Workout"
                    android:textColor="@color/text_main"
                    app:cornerRadius="0dp"
                    app:chipBackgroundColor="@color/surface_card_inner"
                    app:chipStrokeColor="@color/surface_card_stroke_bright" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_yt_ambient"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕ Ambient"
                    android:textColor="@color/text_main"
                    app:cornerRadius="0dp"
                    app:chipBackgroundColor="@color/surface_card_inner"
                    app:chipStrokeColor="@color/surface_card_stroke_bright" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_yt_synth"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌌 Synthwave"
                    android:textColor="@color/text_main"
                    app:cornerRadius="0dp"
                    app:chipBackgroundColor="@color/surface_card_inner"
                    app:chipStrokeColor="@color/surface_card_stroke_bright" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="▶️ Plays in YouTube Music when countdown completes."
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
