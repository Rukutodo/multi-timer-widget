<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiTimer">

        <!-- Main Screen -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Add Dialog Activity (Launched directly from widget + button) -->
        <activity
            android:name=".ui.QuickAddTimerActivity"
            android:exported="false"
            android:theme="@style/Theme.MultiTimer.Dialog"
            android:windowSoftInputMode="adjustResize" />


        <!-- Home Screen Widget Provider -->
        <receiver
            android:name=".widget.MultiTimerWidgetProvider"
            android:label="Multi-Timer (List Widget)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_multi_timer_info" />
        </receiver>

        <!-- Single Timer Hero Widget Provider -->
        <receiver
            android:name=".widget.SingleTimerWidgetProvider"
            android:label="Timer Card (Hero Widget)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.multitimer.ACTION_HERO_PLAY_PAUSE" />
                <action android:name="com.example.multitimer.ACTION_HERO_RESET" />
                <action android:name="com.example.multitimer.ACTION_HERO_NEXT" />
                <action android:name="com.example.multitimer.ACTION_HERO_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_timer_info" />
        </receiver>

        <!-- Widget ListView RemoteViewsService -->
        <service
            android:name=".widget.MultiTimerWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true" />

        <!-- Widget Click Actions Receiver -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.multitimer.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.multitimer.ACTION_RESET" />
                <action android:name="com.example.multitimer.ACTION_TOGGLE_STRATEGY" />
                <action android:name="com.example.multitimer.ACTION_ADD_QUICK" />
            </intent-filter>
        </receiver>

        <!-- Alarm Finish Receiver -->
        <receiver
            android:name=".service.TimerAlarmReceiver"
            android:exported="false" />

        <!-- High-Fi Foreground Tick Service -->
        <service
            android:name=".service.TimerTickService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Timer widget countdown real-time updates" />
        </service>

    </application>

</manifest>
